@model ProductCatalog.Models.ProductListViewModel
@{
    ViewBag.Title = "Products";
}

<h2>Products</h2>

@using (Html.BeginForm("Index", "Products", FormMethod.Get, new { @class = "form-inline" }))
{
    <div class="form-group">
        @Html.TextBox("search", Model.SearchTerm, new { @class = "form-control", placeholder = "Search products..." })
    </div>
    <div class="form-group">
        @Html.DropDownList("categoryId", Model.Categories, "All Categories", new { @class = "form-control" })
    </div>
    <button type="submit" class="btn btn-default">Search</button>
    @Html.ActionLink("Clear", "Index", null, new { @class = "btn btn-link" })
}

<p class="pull-right">
    @Html.ActionLink("Add New Product", "Create", null, new { @class = "btn btn-success" })
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Category?.Name</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.StockQuantity</td>
                <td>
                    @Html.ActionLink("Details", "Details", new { id = product.ProductId }, new { @class = "btn btn-xs btn-info" })
                    @Html.ActionLink("Edit", "Edit", new { id = product.ProductId }, new { @class = "btn btn-xs btn-warning" })
                    @using (Html.BeginForm("Delete", "Products", new { id = product.ProductId }, FormMethod.Post, new { style = "display:inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-xs btn-danger"
                                onclick="return confirm('Delete this product?')">Delete</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<p>Showing @Model.Products.Count() of @Model.TotalCount products | Page @Model.Page</p>
